# Database connection string (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/caregiver_db

# Security token for tool access
MCP_SERVER_TOKEN=default-secret-token

# Server Port
PORT=8000

# AWS Configuration (Required for SNS and Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:CaregiverAlerts
